{
  "compilerOptions": {
    "composite": true,
    "skipLibCheck": true,
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowSyntheticDefaultImports": true,
    "strict": true,
    // Emit outside the repo root: a generated vite.config.js sitting next to
    // vite.config.ts would shadow it, since Vite resolves .js before .ts.
    "outDir": "node_modules/.tmp/tsconfig-node"
  },
  "include": ["vite.config.ts"]
}
